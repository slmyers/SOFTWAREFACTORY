# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class

# Test / coverage
.pytest_cache/
.coverage

# Packaging / build
pip-wheel-metadata/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment files
.env
.env.local

# Editor / OS files
.python-version
.vscode/
.idea/
.DS_Store
.ipynb_checkpoints

# LangSmith specific
.langgraph_api/

# Terraform / providers (ignore runtime plugin dirs and provider binaries)
**/.terraform/
**/.terraform/**/providers/
**/.terraform/**/plugins/
**/terraform-provider-*

# Terraform state / variables / plans (keep lockfile committed)
# Ignore generic state files and backups
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Ignore variable files (may contain secrets)
*.tfvars
*.tfvars.json
*.tfvars.local

# Ignore override and plan artifacts
override.tf
override.tf.json
*_override.tf
crash.log
plan.out
*.tfplan

# Terraform client/machine-level files
.terraform.d/
.terraformrc

# Infra-specific generated archives
infra/**/*.zip
infra/**/*.tgz

# Also ignore any infra-scoped state files explicitly
infra/**/terraform.tfstate*

.ruff_cache/
